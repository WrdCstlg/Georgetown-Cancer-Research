*.pyc
.pytest_cache/
/data/
*.env
.DS_Store
*.sqlite

# Locally fetched third-party score data. NEVER COMMIT.
# AlphaMissense predictions are CC BY-NC-SA 4.0 (non-commercial, share-alike);
# this repo does not redistribute them. Populate with
# `python tools/alphamissense/fetch_scores.py` -- see docs/alphamissense-data.md.
# Redistribution and the NC term remain OPEN under decision D3.
/.cache/
*.tsv.gz

# Throwaway scratch output at the repo root. Root-anchored on purpose: it must
# NOT match anything under fixtures/, tests/, or tools/, where a real file could
# legitimately be named scratch_something.
#
# Why this exists: scratch_eve.json was written to the repo root during the EVE
# build and swept into a commit by `git add -A` (removed in PR #15). It carried
# no prediction scores, but it duplicated a real fixture and should never have
# been tracked. Scratch work belongs in the session scratchpad; this rule is the
# mechanical backstop for when it does not get put there.
/scratch_*
